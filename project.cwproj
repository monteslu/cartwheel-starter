# The game's settings (cartwheel/project.h) and its export presets (cwexport).
# `app` names the executable, the cart and the packages: rename the game here.
name = Lantern Trail
app = lanterntrail
main_scene = main.cwscene
version = 0.1.0
app_id = org.cartwheel.lanterntrail
# gameplay actions; the menus' (ui_*, pause) come from the engine's shell.
# Movement binds the stick AND the d-pad (some pads have no stick); anything
# the game needs binds a button too.
input.move_left = key:a, key:left, pad:left, axis:lx-
input.move_right = key:d, key:right, pad:right, axis:lx+
input.move_forward = key:w, key:up, pad:up, axis:ly-
input.move_back = key:s, key:down, pad:down, axis:ly+
input.jump = key:space, pad:south
layer_names_3d = "world, player, pickups, props"
gravity_3d = vec3(0, -20, 0)
substeps = 4
render.width = 960
render.height = 540
render.msaa = 4
render.vsync = true
# the cart's pictures for launchers and its credits (the engine's docs/shipping.md):
# art = art
description = "Light three lanterns along a cliff trail, then the beacon. The cartwheel starter game."
export.linux-x64.platform = linux-x64
export.linux-arm64.platform = linux-arm64
export.windows-x64.platform = windows-x64
export.macos-arm64.platform = macos
export.android-arm64.platform = android-arm64
